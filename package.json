{
  "name": "rally",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply rally --local",
    "db:migrate:remote": "wrangler d1 migrations apply rally --remote"
  },
  "dependencies": {
    "hono": "4.13.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.12",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.159.0"
  }
}
